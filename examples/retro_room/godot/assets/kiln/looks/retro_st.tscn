[sub_resource type="GDScript" id="GDScript_sun"]
script/source = "extends DirectionalLight3D
# Godot's Compatibility renderer adds the ambient light again for every light with shadows
# (godotengine/godot#90259): everything comes out several times too bright. There the sun casts no shadows.
func _ready() -> void:
	if RenderingServer.get_current_rendering_method() == \"gl_compatibility\":
		shadow_enabled = false
"

[sub_resource type="Shader" id="Shader_post"]
code = "shader_type canvas_item;
render_mode unshaded;

// KILN: the style's retro pass ([look] post = \"retro\"): 200 lines, 16 colours, bayer4
// The screen texture is sRGB while rendering/viewport/hdr_2d is off (Godot's default); the retro looks need it off.
uniform sampler2D screen : hint_screen_texture, filter_nearest;
uniform float lines = 200;
uniform float pixel_aspect = 0.8333;
uniform float strength = 1;
const int COUNT = 16;
const vec3 COLORS[16] = vec3[16](vec3(0, 0, 0), vec3(0, 0.141176, 0.572549), vec3(0, 0.286275, 0), vec3(0.141176, 0.141176, 0.286275), vec3(0.141176, 0.572549, 0.141176), vec3(0.141176, 0.572549, 0.858824), vec3(0.286275, 0.141176, 0), vec3(0.286275, 0.286275, 0.427451), vec3(0.572549, 0, 0), vec3(0.572549, 0.286275, 0), vec3(0.572549, 0.572549, 0.713725), vec3(0.572549, 0.858824, 0.286275), vec3(0.858824, 0.572549, 0.286275), vec3(1, 0.858824, 0), vec3(1, 0.858824, 0.713725), vec3(1, 1, 1));
const int N = 4;
const float THRESHOLDS[16] = float[16](0.03125, 0.53125, 0.15625, 0.65625, 0.78125, 0.28125, 0.90625, 0.40625, 0.21875, 0.71875, 0.09375, 0.59375, 0.96875, 0.46875, 0.84375, 0.34375);

void fragment() {
	vec2 screen_px = 1.0 / SCREEN_PIXEL_SIZE;
	float bh = screen_px.y / min(lines, screen_px.y);  // never under one screen pixel
	vec2 block = vec2(bh * pixel_aspect, bh);
	vec2 cell = floor(SCREEN_UV * screen_px / block);
	vec2 uv = clamp((cell + 0.5) * block / screen_px, vec2(0.0), vec2(1.0));
	vec4 sampled = texture(screen, uv);
	vec3 p = sampled.rgb;
	int i1 = 0;
	int i2 = 0;
	float d1 = 1e9;
	float d2 = 1e9;
	for (int i = 0; i < COUNT; i++) {
		vec3 e = p - COLORS[i];
		float d = dot(e, e);
		if (d < d1) {
			d2 = d1; i2 = i1; d1 = d; i1 = i;
		} else if (d < d2) {
			d2 = d; i2 = i;
		}
	}
	vec3 c1 = COLORS[i1];
	vec3 c2 = COLORS[i2];
	vec3 span = c2 - c1;
	float t = COUNT > 1 ? clamp(dot(p - c1, span) / max(dot(span, span), 1e-9), 0.0, 1.0) : 0.0;
	ivec2 at = ivec2(mod(cell, float(N)));
	float threshold = THRESHOLDS[at.y * N + at.x];
	COLOR = vec4(threshold < t * strength ? c2 : c1, step(0.5, sampled.a));  // a game's screen is opaque; engine previews keep their transparent background
}
"

