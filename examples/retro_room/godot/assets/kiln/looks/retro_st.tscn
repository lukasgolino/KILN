[sub_resource type="GDScript" id="GDScript_sun"]
script/source = "extends DirectionalLight3D
# Godot's Compatibility renderer adds the ambient light again for every light with shadows
# (godotengine/godot#90259): everything comes out several times too bright. There the sun casts no shadows.
func _ready() -> void:
	if RenderingServer.get_current_rendering_method() == \"gl_compatibility\":
		shadow_enabled = false
"

[sub_resource type="Shader" id="Shader_post"]
code = "shader_type canvas_item;
render_mode unshaded;

// KILN's retro pass ([look] post = \"retro\"): every setting is a uniform; the look kit's material holds the style's
// values and the Retro node's script changes them at runtime. The screen texture is sRGB while
// rendering/viewport/hdr_2d is off (Godot's default); the retro looks need it off.
uniform sampler2D screen : hint_screen_texture, filter_nearest;
uniform float lines = 200.0;
uniform float pixel_aspect = 1.0;
uniform float strength = 1.0;
uniform int pattern = 0;  // 0 bayer4, 1 bayer8, 2 none, 3 halftone, 4 lines, 5 hatch, 6 noise
uniform int count = 2;
uniform vec3 colors[16];

const float BAYER4[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
const float BAYER8[64] = float[64](0.0, 32.0, 8.0, 40.0, 2.0, 34.0, 10.0, 42.0, 48.0, 16.0, 56.0, 24.0, 50.0, 18.0, 58.0, 26.0, 12.0, 44.0, 4.0, 36.0, 14.0, 46.0, 6.0, 38.0, 60.0, 28.0, 52.0, 20.0, 62.0, 30.0, 54.0, 22.0, 3.0, 35.0, 11.0, 43.0, 1.0, 33.0, 9.0, 41.0, 51.0, 19.0, 59.0, 27.0, 49.0, 17.0, 57.0, 25.0, 15.0, 47.0, 7.0, 39.0, 13.0, 45.0, 5.0, 37.0, 63.0, 31.0, 55.0, 23.0, 61.0, 29.0, 53.0, 21.0);
const float HALFTONE[64] = float[64](56.0, 40.0, 8.0, 4.0, 0.0, 16.0, 32.0, 60.0, 44.0, 50.0, 30.0, 12.0, 20.0, 26.0, 54.0, 36.0, 10.0, 28.0, 48.0, 42.0, 34.0, 52.0, 24.0, 18.0, 6.0, 14.0, 46.0, 58.0, 62.0, 38.0, 22.0, 2.0, 1.0, 17.0, 33.0, 61.0, 57.0, 41.0, 9.0, 5.0, 21.0, 27.0, 55.0, 37.0, 45.0, 51.0, 31.0, 13.0, 35.0, 53.0, 25.0, 19.0, 11.0, 29.0, 49.0, 43.0, 63.0, 39.0, 23.0, 3.0, 7.0, 15.0, 47.0, 59.0);
const float HATCH[16] = float[16](0.0, 6.0, 14.0, 8.0, 10.0, 4.0, 12.0, 2.0, 15.0, 9.0, 1.0, 7.0, 13.0, 3.0, 11.0, 5.0);
const float LINE_ORDER[4] = float[4](0.0, 2.0, 1.0, 3.0);

float threshold(vec2 cell) {
	if (pattern == 0) {
		ivec2 a = ivec2(mod(cell, 4.0));
		return (BAYER4[a.y * 4 + a.x] + 0.5) / 16.0;
	}
	if (pattern == 1) {
		ivec2 a = ivec2(mod(cell, 8.0));
		return (BAYER8[a.y * 8 + a.x] + 0.5) / 64.0;
	}
	if (pattern == 3) {
		ivec2 a = ivec2(mod(cell, 8.0));
		return (HALFTONE[a.y * 8 + a.x] + 0.5) / 64.0;
	}
	if (pattern == 4) {
		return (LINE_ORDER[int(mod(cell.y, 4.0))] + 0.5) / 4.0;
	}
	if (pattern == 5) {
		ivec2 a = ivec2(mod(cell, 4.0));
		return (HATCH[a.y * 4 + a.x] + 0.5) / 16.0;
	}
	if (pattern == 6) {
		float f = 0.06711056 * cell.x + 0.00583715 * cell.y;
		float g = 52.9829189 * (f - floor(f));
		return clamp(g - floor(g), 0.001, 0.999);
	}
	return 1.0;  // none
}

void fragment() {
	vec2 screen_px = 1.0 / SCREEN_PIXEL_SIZE;
	float bh = screen_px.y / min(lines, screen_px.y);  // never under one screen pixel
	vec2 block = vec2(bh * pixel_aspect, bh);
	vec2 cell = floor(SCREEN_UV * screen_px / block);
	vec2 uv = clamp((cell + 0.5) * block / screen_px, vec2(0.0), vec2(1.0));
	vec4 sampled = texture(screen, uv);
	vec3 p = sampled.rgb;
	int n = clamp(count, 1, 16);
	int i1 = 0;
	int i2 = 0;
	float d1 = 1e9;
	float d2 = 1e9;
	for (int i = 0; i < n; i++) {
		vec3 e = p - colors[i];
		float d = dot(e, e);
		if (d < d1) {
			d2 = d1; i2 = i1; d1 = d; i1 = i;
		} else if (d < d2) {
			d2 = d; i2 = i;
		}
	}
	vec3 c1 = colors[i1];
	vec3 c2 = colors[i2];
	vec3 span = c2 - c1;
	float t = n > 1 ? clamp(dot(p - c1, span) / max(dot(span, span), 1e-9), 0.0, 1.0) : 0.0;
	COLOR = vec4(threshold(cell) < t * strength ? c2 : c1, step(0.5, sampled.a));  // a game's screen is opaque; engine previews keep their transparent background
}
"

